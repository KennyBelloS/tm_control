# Copia este archivo como «.env» (el archivo .env NO se sube a GitHub) y reemplaza los marcadores por tus valores.
# Las que empiezan por VITE_ son públicas (van dentro de la app). Las otras son SECRETAS: nunca les pongas VITE_ delante.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=PEGA_AQUI_LA_LLAVE_PUBLICA_anon

# SECRETAS (solo en tu .env local y en Vercel → Settings → Environment Variables). Sirven para crear/administrar usuarios y para las tareas automáticas.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
